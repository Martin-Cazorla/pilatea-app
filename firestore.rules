rules_version = '2';

// Reglas de seguridad de Firestore para PILATEA.
// Deploy: firebase deploy --only firestore:rules
//
// Modelo de permisos:
// - Admin: documento alumnos/{uid} con role == 'admin'. Puede leer y escribir todo.
// - Alumno: lee su propio documento, sus reservas y los turnos; solo puede mover
//   sus créditos de a 1, y únicamente en la misma escritura en que crea o
//   cancela una reserva propia.
//
// Reservas y cupo:
// - turnos/{disciplinaId}_{fecha}_{HHMM} lleva el contador `ocupados` de la clase.
// - reservas/{turnoId}_{uid}: un alumno tiene a lo sumo una reserva por clase.
// - Reservar = crear la reserva + ocupados+1 (sin pasar las vacantes de
//   configuracion/clases) + creditos-1, en la misma transacción.
// - Cancelar = borrar la reserva + ocupados-1 + creditos+1, y solo antes de
//   que empiece la clase.
// - Como ocupados tiene que ser exactamente el valor anterior + 1, dos alumnos
//   que van por el último cupo a la vez no pueden pasar los dos.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function alumnoPath(uid) {
      return /databases/$(database)/documents/alumnos/$(uid);
    }

    function reservaPath(id) {
      return /databases/$(database)/documents/reservas/$(id);
    }

    function turnoPath(id) {
      return /databases/$(database)/documents/turnos/$(id);
    }

    function configClasesPath() {
      return /databases/$(database)/documents/configuracion/clases;
    }

    function isAdmin() {
      return signedIn()
        && exists(alumnoPath(request.auth.uid))
        && get(alumnoPath(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function turnoIdDe(d) {
      return d.disciplinaId + '_' + d.fecha + '_' + d.hora.replace(':', '');
    }

    function reservaIdDe(d) {
      return turnoIdDe(d) + '_' + d.alumnoId;
    }

    // Inicio de la clase. fecha 'YYYY-MM-DD' y hora 'HH:00' están en hora de
    // Argentina, que es UTC-3 todo el año (no hay horario de verano).
    function inicioClase(d) {
      let f = d.fecha.split('-');
      return timestamp.date(int(f[0]), int(f[1]), int(f[2]))
        + duration.value(int(d.hora.split(':')[0]) + 3, 'h');
    }

    function claseFutura(d) {
      return request.time < inicioClase(d);
    }

    // Vacantes que configuró el admin (5 si no hay configuración, como el cliente).
    function vacantes(disciplinaId) {
      return exists(configClasesPath())
        ? int(get(configClasesPath()).data.get(disciplinaId, {}).get('vacantes', 5))
        : 5;
    }

    function ocupadosAntes(turnoId) {
      return exists(turnoPath(turnoId)) ? get(turnoPath(turnoId)).data.ocupados : 0;
    }

    function ocupadosDespues(turnoId) {
      return existsAfter(turnoPath(turnoId)) ? getAfter(turnoPath(turnoId)).data.ocupados : 0;
    }

    // Alumno descuenta 1 crédito al crear una reserva nueva propia en la misma escritura.
    function isBookingDebit(uid) {
      let id = request.resource.data.ultimaReserva;
      return onlyChanged(['creditos', 'ultimaReserva'])
        && id is string
        && request.resource.data.creditos == resource.data.creditos - 1
        && request.resource.data.creditos >= 0
        && !exists(reservaPath(id))
        && existsAfter(reservaPath(id))
        && getAfter(reservaPath(id)).data.alumnoId == uid;
    }

    // Alumno recupera 1 crédito al borrar una reserva propia en la misma escritura.
    // (La regla de borrado de la reserva exige que la clase no haya empezado.)
    function isCancelRefund(uid) {
      let id = request.resource.data.ultimaCancelacion;
      return onlyChanged(['creditos', 'ultimaCancelacion'])
        && id is string
        && request.resource.data.creditos == resource.data.creditos + 1
        && exists(reservaPath(id))
        && !existsAfter(reservaPath(id))
        && get(reservaPath(id)).data.alumnoId == uid;
    }

    function isValidReserva(data) {
      return data.keys().hasOnly(['alumnoId', 'alumnoNombre', 'fecha', 'hora',
                                  'disciplina', 'disciplinaId', 'fechaCreacion'])
        && data.keys().hasAll(['alumnoId', 'fecha', 'hora', 'disciplinaId'])
        && data.fecha is string && data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.hora is string && data.hora.matches('^[0-9]{2}:00$')
        && data.disciplinaId in ['reformer', 'hiit', 'yoga'];
    }

    // Alumno suma su reserva a un turno: ocupados sube exactamente 1, sin pasar
    // las vacantes, y la reserva {turnoId}_{uid} se crea en la misma escritura.
    function isTurnoIngreso(turnoId, d) {
      let r = reservaPath(turnoId + '_' + request.auth.uid);
      return d.ocupados == ocupadosAntes(turnoId) + 1
        && d.ocupados <= vacantes(d.disciplinaId)
        && !exists(r)
        && existsAfter(r);
    }

    // Alumno libera su lugar: ocupados baja exactamente 1 y su reserva se borra.
    function isTurnoEgreso(turnoId, d) {
      let r = reservaPath(turnoId + '_' + request.auth.uid);
      return d.ocupados == ocupadosAntes(turnoId) - 1
        && d.ocupados >= 0
        && exists(r)
        && !existsAfter(r);
    }

    // ---------- Alumnos ----------
    match /alumnos/{uid} {
      allow read: if isAdmin() || isSelf(uid);

      // El alta la hace el admin con su propia sesión (el usuario de Auth se
      // crea en una app secundaria, ver js/utils/alumnos.js).
      allow create: if isAdmin();

      allow update: if isAdmin()
        || (isSelf(uid) && (isBookingDebit(uid) || isCancelRefund(uid)));

      allow delete: if isAdmin();
    }

    // ---------- Turnos (contador de cupo por clase) ----------
    match /turnos/{turnoId} {
      // El alumno necesita los contadores para ver cuántos cupos quedan.
      allow read: if signedIn();

      allow create: if isAdmin()
        || (signedIn()
            && request.resource.data.keys().hasOnly(['disciplinaId', 'fecha', 'hora', 'ocupados'])
            && request.resource.data.disciplinaId is string
            && request.resource.data.fecha is string
            && request.resource.data.hora is string
            && turnoId == turnoIdDe(request.resource.data)
            && isTurnoIngreso(turnoId, request.resource.data));

      allow update: if isAdmin()
        || (signedIn()
            && onlyChanged(['ocupados'])
            && (isTurnoIngreso(turnoId, request.resource.data)
                || isTurnoEgreso(turnoId, request.resource.data)));

      allow delete: if isAdmin();
    }

    // ---------- Reservas ----------
    match /reservas/{reservaId} {
      // Cada alumno ve solo sus reservas; los cupos salen de /turnos.
      allow read: if isAdmin()
        || (signedIn() && resource.data.alumnoId == request.auth.uid);

      allow create: if isAdmin()
        || (signedIn()
            && request.resource.data.alumnoId == request.auth.uid
            && isValidReserva(request.resource.data)
            && reservaId == reservaIdDe(request.resource.data)
            && claseFutura(request.resource.data)
            && ocupadosDespues(turnoIdDe(request.resource.data))
               == ocupadosAntes(turnoIdDe(request.resource.data)) + 1
            && getAfter(alumnoPath(request.auth.uid)).data.get('ultimaReserva', '') == reservaId
            && getAfter(alumnoPath(request.auth.uid)).data.creditos
               == get(alumnoPath(request.auth.uid)).data.creditos - 1);

      allow update: if isAdmin();

      // El alumno cancela solo antes de que empiece la clase; después, solo el admin.
      allow delete: if isAdmin()
        || (signedIn()
            && resource.data.alumnoId == request.auth.uid
            && reservaId == reservaIdDe(resource.data)
            && claseFutura(resource.data)
            && ocupadosDespues(turnoIdDe(resource.data))
               == ocupadosAntes(turnoIdDe(resource.data)) - 1
            && getAfter(alumnoPath(request.auth.uid)).data.get('ultimaCancelacion', '') == reservaId
            && getAfter(alumnoPath(request.auth.uid)).data.creditos
               == get(alumnoPath(request.auth.uid)).data.creditos + 1);
    }

    // ---------- Configuración (clases y calendario) ----------
    match /configuracion/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Todo lo demás queda cerrado.
  }
}
